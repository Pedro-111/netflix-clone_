<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:elevation="4dp"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@android:color/white">

        <!-- FrameLayout para superponer el icono de edición sobre la imagen de perfil -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Imagen circular -->
            <ImageView
                android:id="@+id/profile_image_manage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Perfil"
                android:scaleType="centerCrop" />

            <!-- Icono de edición superpuesto -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|center_horizontal"
                android:layout_margin="4dp"
                android:src="@drawable/ic_edit" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Nombre centrado debajo de la imagen -->
    <TextView
        android:id="@+id/tv_profile_name_manage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"/>
</LinearLayout>
